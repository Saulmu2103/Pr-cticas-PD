#include <Arduino.h>

void led_rojo (void * parameter);

void led_verde (void * parameter);

int LED_R = 42;

int LED_V = 21;

void setup() 
{
  Serial.begin(115200);

  pinMode(LED_R, OUTPUT);

  pinMode(LED_V, OUTPUT);

  xTaskCreate(led_rojo, "led_rojo", 1000, NULL, 1, NULL);

  xTaskCreate(led_verde, "led_verde", 1000, NULL, 1, NULL);

}

void loop() 
{

}

void led_rojo (void * parameter)
{
  for(;;){
    digitalWrite(LED_R, HIGH);
    delay(1000);
    digitalWrite(LED_R, LOW);
    delay(1000);
  }
vTaskDelete(NULL);
}

void led_verde (void * parameter)
{
  for(;;){
    digitalWrite(LED_V, HIGH);
    delay(1000);
    digitalWrite(LED_V, LOW);
    delay(1000);
  }
vTaskDelete(NULL);
}
