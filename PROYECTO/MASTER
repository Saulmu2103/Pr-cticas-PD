//CODIGO PARA EL MAESTRO

#include <Adafruit_AHTX0.h>
#include <Wire.h>
#include <WiFi.h>
#include <esp_wifi.h>
#include <RTClib.h>
#include <vector>  
#include <LiquidCrystal_I2C.h>

#define I2C_SDA 8
#define I2C_SCL 9

byte grados[8] = {
  B11100,
  B10100,
  B11100,
  B00000,
  B00000,
  B00000,
  B00000,
  B00000
};

LiquidCrystal_I2C lcd(0x27, 20, 4);

WiFiServer server(3333); // Puerto del servidor
WiFiClient client; // Cliente WiFi

const char* ssid = "MASTER";    // Nombre de la red
const char* password = "masterssid";  // Contraseña (mínimo 8 caracteres)

void hora_temp(); // Declaración de la función hora_temp
void esclavo();

Adafruit_AHTX0 aht10;
RTC_DS3231 rtc;

void setup() 
{
  Serial.begin(115200);
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("Iniciando...");
  delay(1000);
  Wire.begin(I2C_SDA, I2C_SCL);  // Inicialización I2C añadida

  aht10.begin();
  rtc.begin();
    
  // Ajustar hora si el RTC perdió energía (descomenta para configurar)
  // rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));

  lcd.clear();
  lcd.setCursor(0, 0);

  WiFi.softAP(ssid, password);
  lcd.print("Red WiFi creada");
  lcd.setCursor(0, 1);
  lcd.print("SSID: ");
  lcd.print(ssid);
  lcd.setCursor(0, 2);
  lcd.print("Pswd: ");
  lcd.print(password);
  lcd.setCursor(0, 3);
  lcd.print("IP: ");
  lcd.print(WiFi.softAPIP());
  delay(5000);
  lcd.clear();
}

void loop() 
{
  hora_temp(); // Llamada a la función para mostrar hora y temperatura
}

void hora_temp()
{
  // TEMPERATURA
  DateTime now = rtc.now();
  lcd.setCursor(0, 0);
  if (now.hour() < 10) lcd.print('0');
  lcd.print(now.hour());
  lcd.print(':');
  if (now.minute() < 10) lcd.print('0');
  lcd.print(now.minute());

  // TEMPERATURA
  lcd.createChar(1, grados);
  sensors_event_t humidity, temp;
  aht10.getEvent(&humidity, &temp);
  lcd.setCursor(7, 0);
  lcd.print(" ");
  lcd.print("T:");  
  lcd.print(temp.temperature, 1);
  lcd.write(byte(1));
  lcd.print("C");

  esclavo(); // Llamada a la función esclavo
}
  
void esclavo()
// Código del servidor modificado
{
  // Verificar si hay clientes conectados
  if (!client || !client.connected()) {
    client = server.available();
    if (client) {
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Cliente conectado!");  // Cambiado println por print
    }
  }

  // Leer datos del cliente
  if (client && client.connected()) {
    if (client.available()) {
      String message = client.readStringUntil('\n');
      message.trim();
      
      // Mostrar en LCD
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("Mensaje recibido:");
      lcd.setCursor(0, 1);  // Segunda línea si es display 16x2
      lcd.print(message);

      // Enviar respuesta al cliente (FUNDAMENTAL)  // <- Cambio clave
      client.print("ECO: ");  
      client.println(message); 

      delay(100);  // Pequeño delay para estabilidad
    }
    
    // Cerrar conexión después de 30 seg de inactividad (Opcional)
    static unsigned long lastActivity = millis();
    if (millis() - lastActivity > 30000) {
      client.stop();
      lcd.clear();
      lcd.print("Conexion cerrada");
      delay(2000);
    }
  }
}
