#define TFT_CS   7
#define TFT_DC   6
#define TFT_RST  5

Adafruit_ILI9341 tft(TFT_CS, TFT_DC, TFT_RST);

#define GRAPH_X 130
#define GRAPH_Y 45
#define GRAPH_WIDTH 180
#define GRAPH_HEIGHT 30
#define MAX_HISTORY GRAPH_WIDTH

float tempHistory[MAX_HISTORY];
int historyCount = 0;

WebServer server(80);
const char* ssid = "esp";
const char* password = "masterssid";
String receivedData = "ND";

void handleRoot() {
  String html = R"=====(
  <!DOCTYPE html>
  <html>
  <head>
    <title>Datos del Sensor</title>
    <meta http-equiv="refresh" content="2">  // Actualiza cada 2 segundos
    <style>
      body { font-family: Arial; text-align: center; margin-top: 50px; }
      button { padding: 10px 20px; font-size: 16px; }
    </style>
  </head>
  <body>
    <h1>Datos Recibidos</h1>
    <div id="data">%DATA%</div>
    <br>
    <a href="/download"><button>Descargar Datos</button></a>
  </body>
  </html>
  )=====";

  html.replace("%DATA%", receivedData);
  server.send(200, "text/html", html);
}


void handleDownload() {
  server.send(200, "text/plain", receivedData);  // Envía los datos como texto plano
}

void handlePost() {
  if (server.hasArg("plain")) {
    receivedData = server.arg("plain");
    server.send(200, "text/plain", "Datos recibidos");
  }
}

Adafruit_AHTX0 aht10;
RTC_DS3231 rtc;

unsigned long lastUpdate = 0;
const int refreshInterval = 1000;

void hora_temp();

void setup() {
  Serial.begin(115200);
  tft.begin();
  tft.setRotation(3);
  tft.fillScreen(ILI9341_BLACK);
  
  // Configuración de colores iniciales
  tft.setTextColor(ILI9341_YELLOW, ILI9341_CYAN);

  Wire.begin(8, 9);

  if (!aht10.begin() || !rtc.begin()) {
    tft.setTextColor(ILI9341_WHITE, ILI9341_BLACK);
    tft.println("Error Sensores!");
    while(1);
  }

   // Ajustar hora si el RTC perdió energía (descomenta para configurar)
  //rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));

  WiFi.softAP(ssid, password);
  Serial.print("IP del receptor: ");
  Serial.println(WiFi.softAPIP());

  // Configurar rutas del servidor
  server.on("/", handleRoot);
  server.on("/download", handleDownload);
  server.on("/data", HTTP_POST, handlePost);
  
  server.begin();
  
  tft.fillScreen(ILI9341_DARKCYAN);
  tft.setTextColor(ILI9341_YELLOW, ILI9341_DARKCYAN);
  tft.setTextSize(2);
  tft.setCursor(40, 100);
  tft.print("INICIANDO SISTEMA...");
  delay(3000);
  tft.fillScreen(ILI9341_BLACK);

  tft.setTextColor(ILI9341_GREEN, ILI9341_BLACK);
  tft.setTextSize(2);
  tft.setCursor(10, 12);
  tft.print("INTERIOR");
 
  tft.setTextSize(2);
  tft.setCursor(10, 50);
  tft.print("T:");

  tft.setCursor(10, 90);
  tft.print("EXTERIOR");

  tft.setCursor(10, 130);
  tft.print("T:");
  tft.setCursor(10, 170);
  tft.print("P:");
  tft.setCursor(10, 210);
  tft.print("H:");

  tft.drawRect(GRAPH_X, GRAPH_Y, GRAPH_WIDTH, GRAPH_HEIGHT, ILI9341_RED); //Como mola mas con el recuadro o sin

  tft.drawRect(130, 125, GRAPH_WIDTH, GRAPH_HEIGHT, ILI9341_RED);
  tft.drawRect(130, 165, GRAPH_WIDTH, GRAPH_HEIGHT, ILI9341_RED);
  tft.drawRect(130, 205, GRAPH_WIDTH, GRAPH_HEIGHT, ILI9341_RED);
}

void loop() {
  if (millis() - lastUpdate >= refreshInterval) {
    hora_temp();
    lastUpdate = millis();
  }
}

void hora_temp() {
  static int lastHour = -1, lastMinute = -1;
  static float lastTemp = -100;
  const int timeX = 250, timeY = 12;
  const int tempX = 40 , tempY = 50;

  // Actualizar Hora
  DateTime now = rtc.now();
  if(now.hour() != lastHour || now.minute() != lastMinute) {
    tft.fillRect(timeX, timeY, 100, 20,   ILI9341_BLACK);
    tft.setTextColor(ILI9341_GREEN, ILI9341_BLACK);
    tft.setCursor(timeX, timeY);
    if(now.hour() < 10) tft.print('0');
    tft.print(now.hour());
    tft.print(':');
    if(now.minute() < 10) tft.print('0');
    tft.print(now.minute());
    lastHour = now.hour();
    lastMinute = now.minute();
  }

  // Actualizar Temperatura
  sensors_event_t temp;
  aht10.getEvent(NULL, &temp);
  if(abs(temp.temperature - lastTemp) >= 0.1) {
    tft.fillRect(tempX, tempY, 80, 20, ILI9341_BLACK);
    tft.setTextColor( ILI9341_GREEN, ILI9341_BLACK);    
    tft.setCursor(tempX, tempY);
    tft.print(temp.temperature, 1);
    tft.print(" C");
    tft.drawCircle(tempX + 55, tempY + 3, 2, ILI9341_GREEN);  // Símbolo °
    lastTemp = temp.temperature;
  }
   if (historyCount < MAX_HISTORY) {
      tempHistory[historyCount] = temp.temperature;
      historyCount++;
    } else {
      memmove(tempHistory, tempHistory + 1, (MAX_HISTORY - 1) * sizeof(float));
      tempHistory[MAX_HISTORY - 1] = temp.temperature;
    }
    // Dibujar gráfico
    tft.fillRect(GRAPH_X + 1, GRAPH_Y + 1, GRAPH_WIDTH - 2, GRAPH_HEIGHT - 2, ILI9341_BLACK);

    float minTemp = 100, maxTemp = -100;
    for (int i = 0; i < historyCount; i++) {
      float t = tempHistory[i];
      if (t < minTemp) minTemp = t;
      if (t > maxTemp) maxTemp = t;
    }
    minTemp -= 0.5;
    maxTemp += 0.5;
    if (maxTemp - minTemp < 0.1) maxTemp = minTemp + 0.1;

  if (historyCount > 0) {
      int prevX = GRAPH_X;
      float prevT = tempHistory[0];
      int prevY = GRAPH_Y + GRAPH_HEIGHT - ((prevT - minTemp) / (maxTemp - minTemp)) * GRAPH_HEIGHT;
      prevY = constrain(prevY, GRAPH_Y, GRAPH_Y + GRAPH_HEIGHT - 1);

  for (int i = 1; i < historyCount; i++) {
        float t = tempHistory[i];
        int x = GRAPH_X + i;
        int y = GRAPH_Y + GRAPH_HEIGHT - ((t - minTemp) / (maxTemp - minTemp)) * GRAPH_HEIGHT;
        y = constrain(y, GRAPH_Y, GRAPH_Y + GRAPH_HEIGHT - 1);

        tft.drawLine(prevX, prevY, x, y, ILI9341_GREEN);
        prevX = x;
        prevY = y;
    }
  }
}
